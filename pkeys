def read_json(path: Path, required: bool = False) -> dict:
    if not path.exists():
        if required:
            raise PkeysError(
                f"{path} does not exist",
                EX_CONFIG,
                "pi writes this file; run pi once, or point PKEYS_AGENT_DIR at your agent dir.",
            )
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        raise PkeysError(
            f"{path} is not valid JSON (line {exc.lineno}, column {exc.colno}: {exc.msg})",
            EX_CONFIG,
            f"Fix the syntax there, or restore a backup: ls {path.parent}/*.bak-*",
        )


def write_json(path: Path, data: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def fingerprint(key: str | None) -> str:
    """Short, non-reversible id so you can tell keys apart without printing them."""
    if not key:
        return "-"
    return hashlib.sha256(key.encode()).hexdigest()[:8]


@dataclass
class Keyfile:
    path: Path
    provider: str
    label: str
    value: str

    @property
    def display(self) -> str:
        return f"{self.provider}-{self.label}"


def load_keyfiles() -> list[Keyfile]:
    """Key store entries are named <provider>-<label>.<ext>; content is the key."""
    root = home()
    if not root.exists():
        return []
    out = []
    for path in sorted(root.iterdir()):
        if not path.is_file() or path.name.startswith("."):
            continue
        if path.suffix.lower() not in {".md", ".txt", ".key", ""}:
            continue
        try:
            value = path.read_text().strip()
        except OSError:
            continue
        if not value:
            continue
        stem = path.stem
        if "-" in stem:
            provider, _, label = stem.partition("-")
        else:
            provider, label = stem, "default"
        out.append(Keyfile(path=path, provider=provider, label=label or "default", value=value))
    return out


