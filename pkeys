def sub_state(prov: Provider, state: dict, style: Style) -> str:
    """Subscription status from the last --live run, with its age."""
    cached = (state.get("limits") or {}).get(prov.name)
    if prov.name not in LIMIT_ADAPTERS:
        return style.dim("no api")
    if not cached:
        return style.dim("unknown")
    data = cached.get("data") or {}
    age = human_age(time.time() - (cached.get("fetchedAt") or 0))
    state_name = (data.get("state") or "unknown").lower()
    active = data.get("active")
    if active is False or state_name in ("inactive", "past_due", "canceled"):
        detail = data.get("providerStatus") or state_name
        return style.yellow(f"inactive ({detail})")
    if data.get("note"):
        return style.dim("unknown")
    if data.get("windows"):
        peak = max((w.get("percent") or 0) for w in data["windows"])
        return style.green(f"active, peak {peak:.0f}%") if peak < 90 else style.yellow(f"active, peak {peak:.0f}%")
    if active is True:
        return style.green(f"active ({age})")
    return style.dim("unknown")


def auth_state(prov: Provider, state: dict, style: Style) -> str:
    if prov.auth_type == "oauth":
        if prov.token_expiry:
            remaining = prov.token_expiry - time.time()
            if remaining <= 0:
                return style.red(f"expired {human_duration(remaining)} ago")
            return style.green(f"active, {human_duration(remaining)} left")
        return "oauth (unknown expiry)"
    if not prov.key:
        return style.red("no key")
    cached = (state.get("checks") or {}).get(prov.name) or {}
    if cached.get("state") == "active":
        age = time.time() - (cached.get("checkedAt") or 0)
        return style.green(f"active ({human_age(age)})")
    if cached.get("state") == "invalid":
        return style.red("rejected")
    return style.yellow("unverified")


def limit_state(prov: Provider, live: dict | None) -> str:
    """What the provider can actually tell us: quota windows, metered usage, or nothing."""
    window = (live or {}).get("window") or {}
    if window.get("from") and window.get("to"):
        return f"usage {window['from']}..{window['to']}"
    has_quota = prov.name in LIMIT_ADAPTERS
    has_usage = prov.name in USAGE_ENDPOINTS
    if has_quota and has_usage:
        return "quota + usage api"
    if has_quota:
        return "quota api (plan only)" if prov.name == "zai" else "quota api"
    if has_usage:
        return "usage api"
    return "none"


def keyfile_candidates(cfg: Config, provider: str) -> list[Keyfile]:
    return [k for k in cfg.keyfiles if k.provider == provider]


def active_keyfile(cfg: Config, prov: Provider) -> Keyfile | None:
    for keyfile in keyfile_candidates(cfg, prov.name):
        if prov.key and keyfile.value == prov.key:
            return keyfile
    return None


