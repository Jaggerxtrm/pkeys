# live adapters — only ever called with --live
# --------------------------------------------------------------------------


def http_json(url: str, key: str, timeout: float = 12.0) -> dict:
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"{PROG}/{VERSION}",
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise PkeysError(
                f"{url} rejected the key (HTTP {exc.code})",
                EX_NETWORK,
                "The key is invalid or revoked — rotate it: pkeys rotate --provider <name> --apply",
            )
        if exc.code == 404:
            raise PkeysError(f"{url} has no such endpoint (HTTP 404)", EX_NETWORK)
        raise PkeysError(f"{url} returned HTTP {exc.code}", EX_NETWORK)
    except urllib.error.URLError as exc:
        raise PkeysError(f"cannot reach {url}: {exc.reason}", EX_NETWORK, "Check your network or VPN.")
    except (TimeoutError, json.JSONDecodeError) as exc:
        raise PkeysError(f"{url} did not answer usefully: {exc}", EX_NETWORK)


def live_validate(prov: Provider) -> dict:
    """Cheapest possible authenticated call: list models."""
    if prov.auth_type == "oauth":
        if prov.token_expiry and prov.token_expiry <= time.time():
            return {"state": "expired", "detail": "OAuth token expired — re-authenticate in pi"}
        detail = "OAuth token not exercised over the network"
        if prov.token_expiry:
            detail += f", expires in {human_duration(prov.token_expiry - time.time())}"
        return {"state": "oauth", "detail": detail}
    if not prov.key:
        return {"state": "no-key"}
    if not prov.base_url:
        return {"state": "unknown", "detail": "no base URL on record"}
    path = "/models"
    if prov.name == "nano-gpt":
        path = "/models"
    payload = http_json(prov.base_url.rstrip("/") + path, prov.key)
    models = payload.get("data") or payload.get("models") or []
    return {"state": "active", "models": len(models), "checkedAt": time.time()}


def live_usage(prov: Provider, month: str) -> dict | None:
    """Provider-reported metered usage, where the provider exposes it."""
    if prov.name not in USAGE_ENDPOINTS or not prov.key or not prov.base_url:
        return None
    url = prov.base_url.rstrip("/") + USAGE_ENDPOINTS[prov.name]
    payload = http_json(url, prov.key)
    totals = payload.get("totals") or {}
    models = []
    for entry in payload.get("byModel") or []:
        models.append(
            {
                "model": entry.get("model"),
                "requests": entry.get("requests"),
                "tokens": entry.get("totalTokens"),
                "cost": entry.get("costUsd"),
            }
        )
    return {
        "window": {"from": payload.get("from"), "to": payload.get("to")},
        "asOf": payload.get("asOf"),
        "requests": totals.get("requests"),
        "totalTokens": totals.get("totalTokens"),
        "input": totals.get("inputTokens"),
        "output": totals.get("outputTokens"),
        "cacheRead": totals.get("cacheReadInputTokens"),
        "cost": totals.get("costUsd"),
        "models": sorted(models, key=lambda m: m.get("tokens") or 0, reverse=True),
    }


def fetch_limits(prov: Provider) -> dict | None:
    """Subscription state, quotas and balance, where the provider exposes them.

    Returns a normalised shape so the display code does not care which provider
    answered:
        {active, state, plan, windows[], quotas[], balance, routing, note, source}
    """
    adapter = LIMIT_ADAPTERS.get(prov.name)
    if adapter is None or not prov.key:
        return None
    return adapter(prov)


def _iso_epoch_millis(value: str | None) -> float | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def _limits_opencode(prov: Provider) -> dict:
    """Rolling 5h / weekly / monthly percentage caps with reset times."""
    url = (prov.base_url or "https://opencode.ai/inference/go/v1").rstrip("/") + "/usage"
    payload = http_json(url, prov.key)
    windows = []
    for name, entry in (payload.get("usage") or {}).items():
        if not isinstance(entry, dict):
            continue
        windows.append(
            {
                "name": {"rolling": "rolling 5h", "weekly": "weekly", "monthly": "monthly"}.get(name, name),
                "status": entry.get("status"),
                "percent": entry.get("percent"),
                "resetsAt": _iso_epoch_millis(entry.get("resetsAt")),
            }
        )
    order = {"rolling 5h": 0, "weekly": 1, "monthly": 2}
    windows.sort(key=lambda w: order.get(w["name"], 9))
    return {"active": True, "state": "active", "windows": windows, "source": url}


def _limits_nanogpt(prov: Provider) -> dict:
    """Subscription status, token quotas and USD balance."""
    root = "https://nano-gpt.com"
    url = root + "/api/v1/subscription/usage"
    payload = http_json(url, prov.key)
    quotas = []
    for key, label in (
        ("dailyInputTokens", "daily input tokens"),
        ("weeklyInputTokens", "weekly input tokens"),
        ("dailyImages", "daily images"),
    ):
        entry = payload.get(key)
        if isinstance(entry, dict):
            quotas.append(
                {
                    "name": label,
                    "used": entry.get("used"),
                    "remaining": entry.get("remaining"),
                    "percent": (entry.get("percentUsed") or 0) * 100,
                    "resetsAt": (entry.get("resetAt") or 0) / 1000.0 if entry.get("resetAt") else None,
                }
            )
    limits = payload.get("limits") or {}
    for key, label in (("dailyInputTokens", "daily input tokens"), ("weeklyInputTokens", "weekly input tokens")):
        if limits.get(key) and not any(q["name"] == label for q in quotas):
            quotas.append({"name": label, "used": None, "remaining": limits[key], "percent": 0, "resetsAt": None})

    balance = None
    try:
        request = urllib.request.Request(
            root + "/api/check-balance",
            data=b"{}",
            method="POST",
            headers={"User-Agent": f"{PROG}/{VERSION}", "x-api-key": prov.key, "Content-Type": "application/json"},
        )
        with urllib.request.urlopen(request, timeout=12) as response:
            balance = json.loads(response.read()).get("usd_balance")
    except Exception:
        balance = None

    routing = payload.get("routing") or {}
    return {
        "active": payload.get("active"),
        "state": payload.get("state") or ("active" if payload.get("active") else "inactive"),
        "providerStatus": payload.get("providerStatus"),
        "quotas": quotas,
        "balance": balance,
        "routing": {k: routing.get(k) for k in ("recommendedMode", "reason")},
        "periodEnd": _iso_epoch_millis((payload.get("period") or {}).get("currentPeriodEnd")),
        "source": url,
    }


def _limits_zai(prov: Provider) -> dict:
    """GLM Coding Plan quota. Keys without a coding plan get a clear answer."""
    url = "https://api.z.ai/api/monitor/usage/quota/limit"
    payload = http_json(url, prov.key)
    if not payload.get("success"):
        message = payload.get("msg") or "quota lookup failed"
        return {
            "active": None,
            "state": "unknown",
            "note": "no GLM Coding Plan on this key" if "coding plan" in message else message,
            "source": url,
        }
    windows = []
    for entry in (payload.get("data") or {}).get("limits") or []:
        if isinstance(entry, dict):
            windows.append(entry)
    return {"active": True, "state": "active", "windows": windows, "source": url, "raw": payload.get("data")}


def _commandcode_slug(plan_id: str | None, plan_name: str | None) -> str:
    return f"{plan_id or ''} {plan_name or ''}".lower()


def _limits_commandcode(prov: Provider) -> dict:
    """Plan credits and the two rolling windows behind `/usage` in the CLI.

    One call to /alpha/billing/credits answers everything that matters: the
    monthly credit pool, and the 5-hour and weekly windows already reduced to
    used / cap / resetAt by the provider (no local arithmetic over request
    logs). /alpha/billing/subscriptions is a second call for the plan id,
    status and renewal date.
    """
    url = COMMANDCODE_API + "/alpha/billing/credits"
    payload = http_json(url, prov.key)
    credits = payload.get("credits") or {}
    limits = payload.get("windowLimits") or {}

    subscription = {}
    try:
        subscription = http_json(COMMANDCODE_API + "/alpha/billing/subscriptions", prov.key).get("data") or {}
    except PkeysError:
        subscription = {}

    plan_id = subscription.get("planId")
    slug = _commandcode_slug(plan_id, subscription.get("planName"))
    monthly, five_hour_cap, weekly_cap = None, None, None
    for key, caps in COMMANDCODE_PLAN_CAPS.items():
        if key in slug:
            monthly, five_hour_cap, weekly_cap = caps
            break
    pool = credits.get("monthlyCredits") or monthly

    windows = []
    for label, entry, fallback in (
        ("rolling 5h", limits.get("fiveHour") or {}, five_hour_cap),
        ("weekly", limits.get("weekly") or {}, weekly_cap),
    ):
        cap = entry.get("cap") or fallback or 0
        used = entry.get("used")
        if entry.get("resetAt"):
            # 0 means the window has not opened yet: nothing has been spent in it.
            resets_at = entry["resetAt"] / 1000.0
        else:
            resets_at = None
        windows.append(
            {
                "name": label,
                "status": "exceeded" if entry.get("exceeded") else "ok",
                "used": used,
                "cap": cap or None,
                "percent": (used / cap * 100) if used is not None and cap else 0.0,
                "resetsAt": resets_at,
            }
        )

    extra = (credits.get("purchasedCredits") or 0) + (credits.get("freeCredits") or 0)
    state = subscription.get("status")
    if not state:
        state = "active" if pool else "unknown"
    name = plan_id.replace("individual-", "").replace("team-", "team ").upper() if plan_id else None
    return {
        "active": state in ("active", "trialing"),
        "state": state,
        "plan": name,
        "monthlyCredits": pool,
        "windows": windows,
        "balance": extra if extra else None,
        "periodEnd": _iso_epoch_millis(subscription.get("currentPeriodEnd")),
        "cancelAtPeriodEnd": subscription.get("cancelAtPeriodEnd"),
        "source": url,
    }


# Providers with a real limits surface. Everything absent here has no public
# route: they keep usage in a web UI and send no quota or credit headers on
# inference responses, so nothing can be read from the API.
LIMIT_ADAPTERS = {
    "commandcode": _limits_commandcode,
    "opencode-go": _limits_opencode,
    "nano-gpt": _limits_nanogpt,
    "zai": _limits_zai,
}


def load_state() -> dict:
    try:
        return json.loads(state_path().read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict) -> None:
    try:
        home().mkdir(parents=True, exist_ok=True)
        write_json(state_path(), state)
    except OSError:
        pass


