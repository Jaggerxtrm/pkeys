VERSION = "0.2.0"

# Exit codes: scripts need to tell "you typed it wrong" from "the network broke".
EX_OK = 0
EX_ERROR = 1
EX_USAGE = 2
EX_CONFIG = 3
EX_NETWORK = 4

PROG = "pkeys"


class PkeysError(Exception):
    """An error already written for a human, carrying its own exit code."""

    def __init__(self, message: str, code: int = EX_ERROR, hint: str | None = None):
        super().__init__(message)
        self.message = message
        self.code = code
        self.hint = hint


