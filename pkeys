class Parser(argparse.ArgumentParser):
    """argparse, but errors are one line plus a hint instead of a wall of usage."""

    def error(self, message: str):
        commands = [name for name, _ in COMMAND_SUMMARY]
        hint = None
        if "invalid choice" in message:
            for token in message.split("'"):
                close = difflib.get_close_matches(token, commands, n=1)
                if close and token not in commands:
                    hint = f"Did you mean 'pkeys {close[0]}'?"
                    break
        if hint is None:
            hint = "Run 'pkeys help' for usage."
        raise PkeysError(message, EX_USAGE, hint)


def build_parser() -> Parser:
    parser = Parser(prog=PROG, add_help=False, description="provider key and usage dashboard")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--plain", action="store_true", help="one record per line, tab separated")
    parser.add_argument("--no-color", action="store_true", help="disable colour")
    parser.add_argument("--month", default=None, help="month to report, YYYY-MM")
    parser.add_argument("-q", "--quiet", action="store_true", help="suppress progress output")
    parser.add_argument("-h", "--help", action="store_true", help="show help")
    parser.add_argument("--version", action="store_true", help="show version")

    sub = parser.add_subparsers(dest="command", parser_class=Parser)

    def add(name: str) -> Parser:
        child = sub.add_parser(name, add_help=False)
        child.add_argument("--json", action="store_true")
        child.add_argument("--plain", action="store_true")
        child.add_argument("--no-color", action="store_true")
        child.add_argument("--month", default=None)
        child.add_argument("-q", "--quiet", action="store_true")
        child.add_argument("-h", "--help", action="store_true")
        child.add_argument("--live", action="store_true")
        return child

    status = add("status")
    status.add_argument("--no-usage", action="store_true", help="skip the session-log scan")
    status.add_argument("--no-cache", action="store_true", help="ignore the parse cache")

    usage = add("usage")
    usage.add_argument("provider", nargs="?")
    usage.add_argument("--no-cache", action="store_true")

    models = add("models")
    models.add_argument("provider", nargs="?")
    models.add_argument("--no-usage", action="store_true")

    add("doctor")

    check = add("check")
    check.add_argument("provider", nargs="?")

    limits = add("limits")
    limits.add_argument("provider", nargs="?")

    rotate = add("rotate")
    rotate.add_argument("--provider")
    rotate.add_argument("--key-file")
    rotate.add_argument("--apply", action="store_true")
    rotate.add_argument("--dry-run", action="store_true")
    rotate.add_argument("--list", action="store_true")
    rotate.add_argument("--reason")

    help_cmd = add("help")
    help_cmd.add_argument("topic", nargs="?")

    return parser


COMMANDS = {
    "status": cmd_status,
    "usage": cmd_usage,
    "limits": cmd_limits,
    "models": cmd_models,
    "doctor": cmd_doctor,
    "check": cmd_check,
    "rotate": cmd_rotate,
}


def main(argv: list[str]) -> int:
    parser = build_parser()

    if not argv:
        # No arguments still means "show me the dashboard"; -h gives the help text.
        argv = ["status"]

    if argv in (["-h"], ["--help"], ["help"]):
        return print_help(None)
    if argv[0] == "help":
        return print_help(argv[1] if len(argv) > 1 else None)
    if "--version" in argv:
        print(f"{PROG} {VERSION}")
        return EX_OK
    # `-h` anywhere means help, even trailing.
    if "-h" in argv or "--help" in argv:
        command = argv[0] if argv[0] in COMMAND_HELP else None
        return print_help(command)

    args = parser.parse_args(argv)
    if getattr(args, "command", None) is None:
        args.command = "status"
        # bare invocation with only global flags
        for attribute in ("json", "plain", "no_color", "month", "quiet"):
            if not hasattr(args, attribute):
                setattr(args, attribute, getattr(parser.parse_args([]), attribute, None))
        args.no_usage = False
        args.no_cache = False

    if getattr(args, "live", None) is None:
        args.live = False

    command = args.command
    handler = COMMANDS.get(command)
    if handler is None:
        raise PkeysError(f"unknown command '{command}'", EX_USAGE, "Run 'pkeys help'.")

    style = Style(color_enabled(getattr(args, "no_color", False)))
    if getattr(args, "plain", False):
        style = Style(False)
    return handler(args, style)


def entrypoint() -> None:
    try:
        code = main(sys.argv[1:])
    except PkeysError as exc:
        error(exc.message, exc.hint)
        code = exc.code
    except KeyboardInterrupt:
        note(f"{PROG}: interrupted")
        code = 130
    except BrokenPipeError:
        code = EX_OK
    sys.exit(code)


if __name__ == "__main__":
    entrypoint()
