def current_month() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m")


def load_cache() -> dict:
    try:
        return json.loads(cache_path().read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_cache(cache: dict) -> None:
    try:
        home().mkdir(parents=True, exist_ok=True)
        write_json(cache_path(), cache)
    except OSError:
        pass


def scan_sessions(use_cache: bool = True, quiet: bool = False) -> dict:
    """Aggregate assistant usage per (month, provider, model).

    Cached per file on (mtime, size) so repeat runs are instant.
    """
    root = sessions_dir()
    if not root.exists():
        return {}
    files = sorted(root.rglob("*.jsonl"))
    cache = load_cache() if use_cache else {}
    fresh: dict[str, dict] = {}
    scanned = 0
    show_progress = not quiet and sys.stderr.isatty() and len(files) > 25

    for index, path in enumerate(files, 1):
        try:
            stat = path.stat()
        except OSError:
            continue
        entry = cache.get(str(path))
        if entry and entry.get("mtime") == stat.st_mtime and entry.get("size") == stat.st_size:
            fresh[str(path)] = entry
            continue

        buckets: dict[str, list[float]] = {}
        try:
            with path.open("r", errors="replace") as handle:
                for line in handle:
                    if '"usage"' not in line:
                        continue
                    try:
                        record = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if record.get("type") != "message":
                        continue
                    message = record.get("message") or {}
                    if message.get("role") != "assistant":
                        continue
                    usage = message.get("usage") or {}
                    provider = message.get("provider") or "unknown"
                    model = message.get("model") or "unknown"
                    month = str(record.get("timestamp", ""))[:7] or "unknown"
                    cost = (usage.get("cost") or {}).get("total")
                    bucket = buckets.setdefault(f"{month}\t{provider}\t{model}", [0, 0, 0, 0, 0, 0])
                    bucket[0] += 1  # requests
                    bucket[1] += usage.get("input") or 0
                    bucket[2] += usage.get("output") or 0
                    bucket[3] += usage.get("cacheRead") or 0
                    bucket[4] += usage.get("cacheWrite") or 0
                    bucket[5] += cost if isinstance(cost, (int, float)) else 0
        except OSError:
            continue

        fresh[str(path)] = {"mtime": stat.st_mtime, "size": stat.st_size, "buckets": buckets}
        scanned += 1
        if show_progress and index % 50 == 0:
            print(f"\r  scanning session logs... {index}/{len(files)}", end="", file=sys.stderr)

    if show_progress and scanned:
        print("\r" + " " * 50 + "\r", end="", file=sys.stderr)

    if use_cache and scanned:
        save_cache(fresh)
    elif use_cache:
        save_cache(fresh)

    totals: dict[tuple[str, str, str], dict] = {}
    for entry in fresh.values():
        for key, values in (entry.get("buckets") or {}).items():
            month, provider, model = key.split("\t", 2)
            agg = totals.setdefault(
                (month, provider, model),
                {"requests": 0, "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "cost": 0.0},
            )
            agg["requests"] += values[0]
            agg["input"] += values[1]
            agg["output"] += values[2]
            agg["cacheRead"] += values[3]
            agg["cacheWrite"] += values[4]
            agg["cost"] += values[5]
    for agg in totals.values():
        agg["totalTokens"] = agg["input"] + agg["output"] + agg["cacheRead"] + agg["cacheWrite"]
    return totals


def provider_month_totals(usage: dict, month: str) -> dict[str, dict]:
    out: dict[str, dict] = {}
    for (m, provider, _model), agg in usage.items():
        if m != month:
            continue
        slot = out.setdefault(
            provider,
            {"requests": 0, "totalTokens": 0, "cost": 0.0, "models": {}},
        )
        slot["requests"] += agg["requests"]
        slot["totalTokens"] += agg["totalTokens"]
        slot["cost"] += agg["cost"]
    for (m, provider, model), agg in usage.items():
        if m != month:
            continue
        out[provider]["models"][model] = agg
    return out


def model_month_usage(usage: dict, month: str) -> dict[tuple[str, str], dict]:
    return {(p, model): agg for (m, p, model), agg in usage.items() if m == month}


