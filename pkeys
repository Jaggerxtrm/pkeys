@dataclass
class Provider:
    name: str
    base_url: str | None = None
    api: str | None = None
    key: str | None = None
    key_source: str = "-"
    other_key_sources: list[tuple[str, str]] = field(default_factory=list)
    auth_type: str = "api_key"
    models: list[dict] = field(default_factory=list)
    token_expiry: float | None = None  # epoch seconds
    configured: bool = False  # true when auth.json or models.json mentions it

    @property
    def fingerprint(self) -> str:
        return fingerprint(self.key)

    @property
    def has_conflict(self) -> bool:
        return any(value != self.key for _, value in self.other_key_sources)


@dataclass
class Config:
    auth: dict
    models: dict
    store: dict
    settings: dict
    keyfiles: list[Keyfile]

    @property
    def default_provider(self) -> str:
        return self.settings.get("defaultProvider") or ""

    @property
    def default_model(self) -> str:
        return self.settings.get("defaultModel") or ""


def load_config() -> Config:
    root = agent_dir()
    auth = read_json(root / "auth.json", required=True)
    models = read_json(root / "models.json")
    store = read_json(root / "models-store.json")
    settings = read_json(root / "settings.json")
    if not isinstance(auth, dict):
        raise PkeysError(f"{root / 'auth.json'} does not contain a JSON object", EX_CONFIG)
    return Config(
        auth=auth,
        models=models if isinstance(models, dict) else {},
        store=store if isinstance(store, dict) else {},
        settings=settings if isinstance(settings, dict) else {},
        keyfiles=load_keyfiles(),
    )


def build_providers(cfg: Config) -> dict[str, Provider]:
    providers: dict[str, Provider] = {}

    def ensure(name: str) -> Provider:
        if name not in providers:
            providers[name] = Provider(name=name)
        return providers[name]

    # 1. models.json owns provider definitions for custom providers.
    for name, entry in (cfg.models.get("providers") or {}).items():
        if not isinstance(entry, dict):
            continue
        prov = ensure(name)
        prov.configured = True
        prov.base_url = entry.get("baseUrl")
        prov.api = entry.get("api")
        prov.models = entry.get("models") or []
        if entry.get("apiKey"):
            prov.key = entry["apiKey"]
            prov.key_source = "models.json"

    # 2. auth.json owns credentials.
    for name, entry in cfg.auth.items():
        if not isinstance(entry, dict):
            continue
        if name == "providers":
            for pname, pentry in entry.items():
                if not isinstance(pentry, dict):
                    continue
                prov = ensure(pname)
                prov.configured = True
                prov.base_url = prov.base_url or pentry.get("baseUrl")
                prov.api = prov.api or pentry.get("api")
                if not prov.models:
                    prov.models = pentry.get("models") or []
                key = pentry.get("apiKey")
                if key:
                    if prov.key and prov.key != key:
                        prov.other_key_sources.append(("auth.json/providers", key))
                    elif not prov.key:
                        prov.key = key
                        prov.key_source = "auth.json"
                    else:
                        prov.other_key_sources.append(("auth.json/providers", key))
            continue

        prov = ensure(name)
        prov.configured = True
        auth_type = entry.get("type", "api_key")
        prov.auth_type = auth_type
        if auth_type == "oauth":
            if entry.get("expires"):
                prov.token_expiry = float(entry["expires"]) / 1000.0
            prov.key_source = "auth.json (oauth)"
            continue
        key = entry.get("key")
        if key:
            if prov.key and prov.key != key:
                prov.other_key_sources.append(("auth.json", key))
            elif not prov.key:
                prov.key = key
                prov.key_source = "auth.json"

    # 3. models-store.json fills in base URLs for auth-only providers.
    for name, entry in cfg.store.items():
        if not isinstance(entry, dict):
            continue
        prov = ensure(name)
        if not prov.base_url:
            for model in entry.get("models") or []:
                if model.get("baseUrl"):
                    prov.base_url = model["baseUrl"]
                    break
        if not prov.models:
            prov.models = entry.get("models") or []

    # 4. derived fallbacks.
    for prov in providers.values():
        if not prov.base_url and prov.name in KNOWN_BASE_URLS:
            prov.base_url = KNOWN_BASE_URLS[prov.name]
        if not prov.key:
            candidates = [k for k in cfg.keyfiles if k.provider == prov.name]
            if candidates:
                prov.key = candidates[0].value
                prov.key_source = f"keyfile {candidates[0].path.name}"
                for extra in candidates[1:]:
                    prov.other_key_sources.append((f"keyfile {extra.path.name}", extra.value))

    # 5. keyfiles for providers we do not know about yet.
    for keyfile in cfg.keyfiles:
        if keyfile.provider in providers:
            continue
        prov = ensure(keyfile.provider)
        prov.key = keyfile.value
        prov.key_source = f"keyfile {keyfile.path.name}"

    # models-store.json is a download cache. Providers that exist only there were
    # unconfigured deliberately, so showing them as "no key" would be noise.
    return {name: prov for name, prov in providers.items() if prov.configured}


