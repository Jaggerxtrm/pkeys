class Style:
    """Colour only when a human is watching, and when they have not opted out."""

    def __init__(self, enabled: bool):
        self.enabled = enabled

    def _wrap(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.enabled else text

    def dim(self, t: str) -> str:
        return self._wrap("2", t)

    def bold(self, t: str) -> str:
        return self._wrap("1", t)

    def green(self, t: str) -> str:
        return self._wrap("32", t)

    def yellow(self, t: str) -> str:
        return self._wrap("33", t)

    def red(self, t: str) -> str:
        return self._wrap("31", t)


def color_enabled(no_color_flag: bool) -> bool:
    if no_color_flag or os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


def human_int(n: float | int | None) -> str:
    if n is None:
        return "-"
    n = float(n)
    for limit, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if abs(n) >= limit:
            value = n / limit
            text = f"{value:.1f}" if value < 10 else f"{value:.0f}"
            return f"{text.rstrip('.0')}{suffix}"
    return f"{n:.0f}"


def human_money(n: float | None) -> str:
    if n is None:
        return "-"
    if n == 0:
        return "$0"
    if n < 0.01:
        return f"${n:.4f}"
    return f"${n:,.2f}"


def human_age(seconds: float) -> str:
    if seconds < 90:
        return "just now"
    if seconds < 5400:
        return f"{int(seconds // 60)}m ago"
    if seconds < 172800:
        return f"{int(seconds // 3600)}h ago"
    return f"{int(seconds // 86400)}d ago"


def human_duration(seconds: float) -> str:
    seconds = abs(seconds)
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 172800:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def render_table(headers: list[str], rows: list[list[str]], style: Style) -> str:
    """Aligned columns, no box borders — scanner-friendly."""
    # Cells arrive pre-styled, so measure them without ANSI codes.
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(_strip_ansi(cell)))
    out = []
    head = "  ".join(style.dim(h.ljust(widths[i])) for i, h in enumerate(headers))
    out.append(head.rstrip())
    for row in rows:
        cells = []
        for i, cell in enumerate(row):
            pad = widths[i] - len(_strip_ansi(cell))
            cells.append(cell + " " * max(0, pad))
        out.append("  ".join(cells).rstrip())
    return "\n".join(out)


def _strip_ansi(text: str) -> str:
    out = []
    i = 0
    while i < len(text):
        if text[i] == "\033":
            while i < len(text) and text[i] != "m":
                i += 1
            i += 1
            continue
        out.append(text[i])
        i += 1
    return "".join(out)


def error(message: str, hint: str | None = None) -> None:
    print(f"{PROG}: error: {message}", file=sys.stderr)
    if hint:
        print(f"  {hint}", file=sys.stderr)


def note(message: str) -> None:
    print(message, file=sys.stderr)


