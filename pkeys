    month_usage = model_month_usage(usage, month)

    if args.provider:
        if args.provider not in providers:
            raise PkeysError(
                f"unknown provider '{args.provider}'",
                EX_USAGE,
                "Known providers: " + ", ".join(sorted(providers)),
            )
        selected = [args.provider]
    else:
        selected = sorted(providers)

    if args.json:
        payload = {}
        for name in selected:
            prov = providers[name]
            payload[name] = {
                "baseUrl": prov.base_url,
                "api": prov.api,
                "models": [
                    {
                        "id": model.get("id"),
                        "name": model.get("name"),
                        "reasoning": model.get("reasoning"),
                        "contextWindow": model.get("contextWindow"),
                        "maxTokens": model.get("maxTokens"),
                        "cost": model.get("cost"),
                        "usage": month_usage.get((name, model.get("id"))),
                    }
                    for model in prov.models
                ],
            }
        print(json.dumps({"month": month, "providers": payload}, indent=2, sort_keys=True))
        return EX_OK

    for name in selected:
        prov = providers[name]
        used = [(m, a) for (p, m), a in month_usage.items() if p == name]
        used_total = sum(a["totalTokens"] for _, a in used)
        title = style.bold(name)
        if name == cfg.default_provider:
            title += style.dim(" (default)")
        print(f"{title}  {len(prov.models)} models  {human_int(used_total)} tokens in {month}")
        if not prov.models:
            print(style.dim("  no models configured in models.json or models-store.json"))
            print()
            continue
        rows = []
        for model in prov.models:
            mid = model.get("id")
            agg = month_usage.get((name, mid))
            cost = model.get("cost") or {}
            is_default = name == cfg.default_provider and mid == cfg.default_model
            rows.append(
                [
                    (style.bold(mid) if is_default else mid),
                    human_int(model.get("contextWindow")) if model.get("contextWindow") else "-",
                    f"{cost.get('input', 0):g}/{cost.get('output', 0):g}",
                    human_int(agg["totalTokens"]) if agg else "-",
                    human_money(agg["cost"]) if agg else "-",
                ]
            )
        if args.plain:
            print("model\tcontext\tcost_in_out\ttokens\tcost")
            for row in rows:
                print("\t".join(_plain(c) for c in row))
        else:
            print(render_table(
                ["MODEL", "CONTEXT", "IN/OUT $/Mtok", "TOKENS", "COST"],
                rows,
                style,
            ))
        print()
    return EX_OK


def cmd_doctor(args, style: Style) -> int:
    root = agent_dir()
    problems: list[tuple[str, str, str, str]] = []  # level, area, message, hint

    for name in ("auth.json", "models.json", "settings.json", "models-store.json"):
        path = root / name
        if not path.exists():
            if name in ("auth.json", "models.json"):
                problems.append(("error", name, "missing", "pi writes this; run pi once"))
            continue
        try:
            json.loads(path.read_text())
        except json.JSONDecodeError as exc:
            problems.append(
                ("error", name, f"invalid JSON at line {exc.lineno} col {exc.colno}: {exc.msg}",
                 f"restore a backup: ls {root}/{name}.bak-*")
            )
        except OSError as exc:
            problems.append(("error", name, f"unreadable: {exc}", ""))

    cfg = load_config()
    providers = build_providers(cfg)

    for name, prov in sorted(providers.items()):
        if not prov.key and prov.auth_type != "oauth":
            problems.append(("error", name, "no key configured", f"pkeys rotate --provider {name}"))
        if prov.has_conflict:
            others = ", ".join(source for source, _ in prov.other_key_sources)
            problems.append(
                (
                    "warn",
                    name,
                    f"key defined twice with different values ({prov.key_source} wins, {others} differs)",
                    "keep one source; stale duplicates cause confusing 401s",
                )
            )
        if prov.auth_type == "oauth" and prov.token_expiry:
            remaining = prov.token_expiry - time.time()
            if remaining <= 0:
                problems.append(
                    ("warn", name, f"OAuth token expired {human_duration(remaining)} ago",
                     "run pi and re-authenticate")
                )
            elif remaining < 86400:
                problems.append(
                    ("warn", name, f"OAuth token expires in {human_duration(remaining)}", "re-authenticate soon")
                )
        if not prov.base_url:
            problems.append(("info", name, "no base URL on record", "add it to models.json if you use this provider"))

    # key store hygiene
    for keyfile in cfg.keyfiles:
        mode = keyfile.path.stat().st_mode & 0o777
        if mode & 0o077:
            problems.append(
                (
                    "warn",
                    keyfile.path.name,
                    f"key file is readable by others (mode {mode:o})",
                    f"chmod 600 {keyfile.path}",
                )
            )
        if keyfile.provider not in providers:
            problems.append(("info", keyfile.path.name, "provider not in config", "harmless, kept for rotation"))

    for path in (root / "auth.json",):
        if path.exists():
            mode = path.stat().st_mode & 0o777
            if mode & 0o077:
                problems.append(
                    ("warn", path.name, f"world/group readable (mode {mode:o})", f"chmod 600 {path}")
                )

    # models without usage ever recorded are suspicious only if they claim the default
    if cfg.default_provider and cfg.default_provider not in providers:
        problems.append(
            ("error", "settings.json",
             f"defaultProvider '{cfg.default_provider}' is not a configured provider",
             "pkeys rotate --set-default --provider <name> --model <id>")
        )
    default_models = [m.get("id") for m in providers.get(cfg.default_provider, Provider("")).models]
    if cfg.default_model and default_models and cfg.default_model not in default_models:
        problems.append(
            ("error", "settings.json",
             f"defaultModel '{cfg.default_model}' is not defined under '{cfg.default_provider}'",
             "pick one from: pkeys models --provider " + cfg.default_provider)
        )

    if args.json:
        print(json.dumps(
            {"problems": [
                {"level": level, "area": area, "message": message, "hint": hint}
                for level, area, message, hint in problems
            ]},
            indent=2,
        ))
        return EX_CONFIG if any(p[0] == "error" for p in problems) else EX_OK

    if not problems:
        print(style.green("ok") + " — config parses, every provider has a key, no conflicts")
        return EX_OK

    for level, area, message, hint in problems:
        tag = {
            "error": style.red("error"),
            "warn": style.yellow("warn "),
            "info": style.dim("info "),
        }[level]
        print(f"{tag}  {area}: {message}")
        if hint:
            print(f"       {style.dim(hint)}")

    errors = sum(1 for p in problems if p[0] == "error")
    warns = sum(1 for p in problems if p[0] == "warn")
    print()
    print(style.dim(f"{errors} error(s), {warns} warning(s), {len(problems) - errors - warns} note(s)"))
    return EX_CONFIG if errors else EX_OK


def cmd_rotate(args, style: Style) -> int:
    cfg = load_config()
    providers = build_providers(cfg)
    provider = args.provider
    if not provider:
        raise PkeysError(
            "no provider given",
            EX_USAGE,
            "pkeys rotate --provider commandcode --dry-run   (add --apply to write)",
        )
    if provider not in providers:
        close = difflib.get_close_matches(provider, list(providers), n=1)
        hint = f"Did you mean '{close[0]}'?" if close else "Known providers: " + ", ".join(sorted(providers))
        raise PkeysError(f"unknown provider '{provider}'", EX_USAGE, hint)

    prov = providers[provider]
    candidates = keyfile_candidates(cfg, provider)
    active = active_keyfile(cfg, prov)

    if args.list:
        print(f"{provider}: {len(candidates)} key(s) in {home()}")
        for keyfile in candidates:
            marker = style.green("* ") if active and keyfile.path == active.path else "  "
            print(f"{marker}{keyfile.path.name}  {fingerprint(keyfile.value)}")
        if not candidates:
            print(style.dim(f"  none — add one as {provider}-<label>.md"))
        elif active is None:
            print(style.dim(f"  live key {prov.fingerprint} is not in the store, so no row is starred"))
        return EX_OK

    if not candidates:
        raise PkeysError(
            f"no rotation keys for '{provider}' in {home()}",
            EX_CONFIG,
            f"Add one: printf '%s' '<key>' > {home()}/{provider}-<label>.md && chmod 600 it",
        )

    if args.key_file:
        target = home() / args.key_file
        if not target.exists():
            target = Path(args.key_file)
        if not target.exists():
            raise PkeysError(f"key file not found: {args.key_file}", EX_USAGE)
        chosen = next((k for k in candidates if k.path == target), None)
        if not chosen:
            value = target.read_text().strip()
            chosen = Keyfile(path=target, provider=provider, label=target.stem, value=value)
    else:
        # round-robin: next candidate after the active one, wrapping
        order = candidates
        if active is not None:
            index = order.index(active) if active in order else -1
            chosen = order[(index + 1) % len(order)]
        else:
            chosen = order[0]

    if prov.key == chosen.value:
        print(f"{provider} already uses {chosen.path.name} ({fingerprint(chosen.value)}).")
        print(style.dim("Nothing to rotate."))
        return EX_OK

    print(f"provider   {provider}")
    print(f"current    {prov.key_source}  {fingerprint(prov.key)}")
    if active is None:
        print(style.yellow("note       live key is not in the key store; it cannot be selected again"))
    print(f"next       {chosen.path.name}  {fingerprint(chosen.value)}")
    if prov.has_conflict:
        print(style.yellow("warning    provider key is duplicated across config files; both will be updated"))
    if args.apply:
        pass
    else:
        print()
        print(style.dim("Dry run. Nothing written."))
        print(style.dim(f"Apply with: pkeys rotate --provider {provider}" + (f" --key-file {chosen.path.name}" if args.key_file else "") + " --apply"))
        return EX_OK

    # --- apply ---
    root = agent_dir()
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    backups = []
    for filename in ("auth.json", "models.json"):
        path = root / filename
        if not path.exists():
            continue
        backup = root / f"{filename}.bak-pkeys-{stamp}"
        shutil.copy2(path, backup)
        backups.append(backup)

    changed = []
    auth = read_json(root / "auth.json", required=True)
    if isinstance(auth.get(provider), dict):
        auth[provider]["key"] = chosen.value
        changed.append(f"auth.json[{provider}].key")
    if isinstance((auth.get("providers") or {}).get(provider), dict):
        auth["providers"][provider]["apiKey"] = chosen.value
        changed.append(f"auth.json[providers.{provider}].apiKey")
    if "auth.json" in " ".join(changed):
        write_json(root / "auth.json", auth)

    models_doc = read_json(root / "models.json")
    if isinstance((models_doc.get("providers") or {}).get(provider), dict):
        models_doc["providers"][provider]["apiKey"] = chosen.value
        changed.append(f"models.json[providers.{provider}].apiKey")
        write_json(root / "models.json", models_doc)

    if not changed:
        raise PkeysError(
            f"'{provider}' has no writable key slot in auth.json or models.json",
            EX_CONFIG,
            "Add the provider to models.json first, or rotate the source file by hand.",
        )

    entry = {
        "at": datetime.now(timezone.utc).isoformat(),
        "provider": provider,
        "from": prov.fingerprint,
        "to": fingerprint(chosen.value),
        "keyFile": chosen.path.name,
        "changed": changed,
        "reason": args.reason or "manual",
        "backups": [str(b) for b in backups],
    }
    with rotation_log_path().open("a") as handle:
        handle.write(json.dumps(entry) + "\n")
    os.chmod(rotation_log_path(), 0o600)

    state = load_state()
    state.setdefault("checks", {}).pop(provider, None)
    state.setdefault("rotation", {})[provider] = {
        "active": chosen.path.name,
        "at": entry["at"],
    }
    save_state(state)

    print()
    for line in changed:
        print(style.green("updated") + f"  {line}")
    print(style.dim(f"backups  {', '.join(b.name for b in backups)}"))
    print(style.dim(f"logged   {rotation_log_path()}"))
    print()
    print(style.dim("Verify with: pkeys status --live"))
    return EX_OK


def cmd_check(args, style: Style) -> int:
    cfg = load_config()
    providers = build_providers(cfg)
    state = load_state()
    names = [args.provider] if args.provider else sorted(providers)
    failures = 0
    results = []

    for name in names:
        prov = providers.get(name)
        if not prov:
            raise PkeysError(f"unknown provider '{name}'", EX_USAGE,
                             "Known providers: " + ", ".join(sorted(providers)))
        try:
            result = live_validate(prov)
            if result.get("state") in ("invalid", "expired", "no-key"):
                failures += 1
        except PkeysError as exc:
            result = {"state": "invalid", "detail": exc.message}
            failures += 1
        result["checkedAt"] = time.time()
        state.setdefault("checks", {})[name] = result
        results.append((name, result))
        if not args.json:
            icon = {
                "active": style.green("ok"),
                "no-key": style.red("no key"),
                "invalid": style.red("failed"),
                "expired": style.red("expired"),
                "oauth": style.yellow("oauth"),
                "unknown": style.yellow("unknown"),
            }.get(result.get("state"), "-")
            detail = result.get("detail") or (
                f"{result.get('models')} models visible" if result.get("models") is not None else ""
            )
            print(f"{icon:14} {name:16} {detail}")

    save_state(state)
    if args.json:
        print(json.dumps({name: result for name, result in results}, indent=2, sort_keys=True))
    return EX_NETWORK if failures else EX_OK


