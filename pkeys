def cmd_usage(args, style: Style) -> int:
    cfg = load_config()
    providers = build_providers(cfg)
    month = args.month or current_month()
    usage = scan_sessions(use_cache=not args.no_cache, quiet=args.quiet)

    by_provider = provider_month_totals(usage, month)
    if args.provider:
        if args.provider not in providers and args.provider not in by_provider:
            raise PkeysError(
                f"unknown provider '{args.provider}'",
                EX_USAGE,
                "Known providers: " + ", ".join(sorted(set(providers) | set(by_provider))),
            )
        selected = [args.provider]
    else:
        selected = sorted(set(by_provider) | set(providers))

    live: dict[str, dict] = {}
    if args.live:
        for name in selected:
            prov = providers.get(name)
            if not prov or not prov.key:
                continue
            try:
                reported = live_usage(prov, month)
                if reported:
                    live[name] = reported
            except PkeysError as exc:
                live[name] = {"error": exc.message}
                note(f"{PROG}: warning: {name}: {exc.message}")

    if args.json:
        payload = {"month": month, "providers": {}, "live": live or None}
        for name in selected:
            totals = by_provider.get(name, {})
            payload["providers"][name] = {
                "totals": {k: v for k, v in totals.items() if k != "models"},
                "models": totals.get("models", {}),
            }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return EX_OK

    if args.plain:
        # One record per line, header included, so awk/cut work without parsing prose.
        print("provider\tmodel\ttokens\tshare\tinput\toutput\tcache_read\tcost")
        for name in selected:
            totals = by_provider.get(name, {})
            token_total = totals.get("totalTokens") or 0
            models = totals.get("models", {})
            if not models:
                print(f"{name}\t-\t0\t-\t0\t0\t0\t$0")
                continue
            for model, agg in sorted(models.items(), key=lambda kv: kv[1]["totalTokens"], reverse=True):
                share = (agg["totalTokens"] / token_total * 100) if token_total else 0
                print(
                    "\t".join([
                        name,
                        model,
                        str(agg["totalTokens"]),
                        f"{share:.0f}%",
                        str(agg["input"]),
                        str(agg["output"]),
                        str(agg["cacheRead"]),
                        f"{agg['cost']:.6f}",
                    ])
                )
        return EX_OK

    any_rows = False
    for name in selected:
        totals = by_provider.get(name, {})
        models = totals.get("models", {})
        reported = live.get(name)
        if not models and not reported:
            if args.provider:
                print(f"{name}: no recorded usage for {month}")
                hint = ""
                if name in providers and name not in USAGE_ENDPOINTS:
                    hint = " (this provider does not expose metered usage either)"
                print(style.dim(f"  switch to it, or pass --live{hint}"))
            continue
        any_rows = True
        header = style.bold(name)
        if name == cfg.default_provider:
            header += style.dim(" (default)")
        token_total = totals.get("totalTokens") or 0
        print(f"{header}  {month}  {human_int(token_total)} tokens  {human_money(totals.get('cost'))}  {human_int(totals.get('requests'))} requests")
        if models:
            rows = []
            for model, agg in sorted(models.items(), key=lambda kv: kv[1]["totalTokens"], reverse=True):
                share = (agg["totalTokens"] / token_total * 100) if token_total else 0
                rows.append(
                    [
                        model,
                        human_int(agg["totalTokens"]),
                        f"{share:.0f}%",
                        human_int(agg["input"]),
                        human_int(agg["output"]),
                        human_int(agg["cacheRead"]),
                        human_money(agg["cost"]),
                    ]
                )
            if args.plain:
                print("model\ttokens\tshare\tinput\toutput\tcache_read\tcost")
                for row in rows:
                    print("\t".join(row))
            else:
                print(render_table(
                    ["MODEL", "TOKENS", "SHARE", "INPUT", "OUTPUT", "CACHE RD", "COST"],
                    rows,
                    style,
                ))
        if reported:
            print()
            window = reported.get("window") or {}
            print(
                style.dim(
                    f"  provider-reported {window.get('from')}..{window.get('to')}: "
                    f"{human_int(reported.get('requests'))} requests, "
                    f"{human_int(reported.get('totalTokens'))} tokens, "
                    f"{human_money(reported.get('cost'))}"
                )
            )
            for entry in reported.get("models") or []:
                print(
                    style.dim(
                        f"    {entry.get('model')}: {human_int(entry.get('tokens'))} tokens, "
                        f"{human_int(entry.get('requests'))} requests"
                    )
                )
        print()

    if not any_rows:
        print(f"No usage recorded for {month}.")
        print(style.dim(f"Try another month: pkeys usage --month {_previous_month(month)}"))
    return EX_OK


def _previous_month(month: str) -> str:
    try:
        year, mon = month.split("-")
        year_i, mon_i = int(year), int(mon)
    except ValueError:
        return current_month()
    mon_i -= 1
    if mon_i == 0:
        year_i, mon_i = year_i - 1, 12
    return f"{year_i:04d}-{mon_i:02d}"


def bar(percent: float | None, width: int = 20) -> str:
    """A bar that reads at a glance and still works without colour."""
    if percent is None:
        return " " * width + "   ?"
    filled = int(round(max(0.0, min(100.0, percent)) / 100 * width))
    marks = "#" * filled + "." * (width - filled)
    suffix = f" {percent:>5.1f}%" if percent % 1 else f" {percent:>5.0f}%"
    return marks + suffix


def cmd_limits(args, style: Style) -> int:
    cfg = load_config()
    providers = build_providers(cfg)
    state = load_state()
    selected = [args.provider] if args.provider else sorted(providers)

    if args.provider and args.provider not in providers:
        close = difflib.get_close_matches(args.provider, list(providers), n=1)
        hint = f"Did you mean '{close[0]}'?" if close else "Known providers: " + ", ".join(sorted(providers))
        raise PkeysError(f"unknown provider '{args.provider}'", EX_USAGE, hint)

    results = {}
    failures = 0
    if args.live:
        for name in selected:
            prov = providers[name]
            if prov.name not in LIMIT_ADAPTERS or not prov.key:
                results[name] = (state.get("limits") or {}).get(name, {}).get("data")
                continue
            try:
                data = fetch_limits(prov)
                state.setdefault("limits", {})[name] = {"fetchedAt": time.time(), "data": data}
                results[name] = data
            except PkeysError as exc:
                results[name] = {"state": "unknown", "note": exc.message, "source": None}
                failures += 1
        save_state(state)
    else:
        for name in selected:
            results[name] = (state.get("limits") or {}).get(name, {}).get("data")

    if args.json:
        payload = {}
        for name in selected:
            cached = (state.get("limits") or {}).get(name) or {}
            payload[name] = {
                "fetchedAt": cached.get("fetchedAt"),
                "supportsApi": name in LIMIT_ADAPTERS,
                "data": results.get(name),
            }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return EX_NETWORK if failures else EX_OK

    if args.plain:
        print("provider\tkind\tname\tpercent\tused\tlimit\tremaining\tresets_at\tbalance")
        for name in selected:
            data = results.get(name) or {}
            balance = data.get("balance")
            stamp = _iso(data.get("periodEnd"))
            if data.get("windows"):
                for window in data["windows"]:
                    print("\t".join([
                        name, "window", str(window.get("name")), f"{window.get('percent') or 0:.0f}",
                        str(window.get("used") if window.get("used") is not None else ""),
                        str(window.get("cap") if window.get("cap") is not None else ""),
                        "", _iso(window.get("resetsAt")), balance or "",
                    ]))
            elif data.get("quotas"):
                for quota in data["quotas"]:
                    print("\t".join([
                        name, "quota", str(quota.get("name")), f"{(quota.get('percent') or 0):.0f}",
                        str(quota.get("used") if quota.get("used") is not None else ""),
                        "", str(quota.get("remaining") if quota.get("remaining") is not None else ""),
                        _iso(quota.get("resetsAt")), balance or "",
                    ]))
            else:
                reason = data.get("note") or ("no api" if name not in LIMIT_ADAPTERS else "unknown")
                print("\t".join([name, "none", reason, "", "", "", "", stamp, balance or ""]))
        return EX_NETWORK if failures else EX_OK

    if not args.live:
        print(style.dim("Showing the last fetched values. Add --live to refresh from the providers."))
        print()

    for name in selected:
        data = results.get(name)
        cached = (state.get("limits") or {}).get(name) or {}
        title = style.bold(name)
        if name == cfg.default_provider:
            title += style.dim(" (default)")
        if name not in LIMIT_ADAPTERS:
            print(f"{title}  {style.dim('no limits API')}")
            print(style.dim("  no public route exposes plan or quota for this provider"))
            print()
            continue
        if not data:
            print(f"{title}  {style.dim('never fetched')}")
            print(style.dim(f"  pkeys limits {name} --live"))
            print()
            continue

        when = cached.get("fetchedAt")
        print(f"{title}  {style.dim(human_age(time.time() - when) if when else 'unknown age')}")

        if data.get("note"):
            print(f"  status      {style.yellow(data['note'])}")
        elif data.get("state"):
            state_name = data["state"]
            detail = data.get("providerStatus")
            text = state_name + (f" ({detail})" if detail and detail != state_name else "")
            coloured = style.green(text) if data.get("active") else style.yellow(text) if data.get("active") is False else text
            print(f"  status      {coloured}")
        if data.get("plan"):
            print(f"  {'plan':<20}{data['plan']}")
        for window in data.get("windows") or []:
            window_name = str(window.get("name"))
            status = window.get("status")
            if status and status != "ok":
                window_name += f" {style.red(status)}"
            reset = window.get("resetsAt")
            line = f"  {window_name:<14}{bar(window.get('percent'))}"
            if window.get("used") is not None and window.get("cap"):
                line += f"   {human_money(window['used'])} of {human_money(window['cap'])}"
            if reset:
                line += style.dim(f"   resets in {human_duration(reset - time.time())}")
            print(line)
        for quota in data.get("quotas") or []:
            used = quota.get("used")
            remaining = quota.get("remaining")
            parts = [f"  {str(quota.get('name')):<20}{bar(quota.get('percent'))}"]
            if used is not None and remaining is not None:
                parts.append(f"{human_int(used)} used, {human_int(remaining)} left")
            elif remaining is not None:
                parts.append(f"{human_int(remaining)} allowance")
            reset = quota.get("resetsAt")
            if reset:
                parts.append(f"resets in {human_duration(reset - time.time())}")
            print("   ".join(parts))
        if data.get("balance") is not None:
            try:
                print(f"  {'balance':<20}{human_money(float(data['balance']))} USD")
            except (TypeError, ValueError):
                print(f"  {'balance':<20}{data['balance']} USD")
        routing = data.get("routing") or {}
        if routing.get("recommendedMode"):
            print(style.dim(f"  routing           {routing['recommendedMode']} — {routing.get('reason') or ''}"))
        if data.get("source"):
            print(style.dim(f"  source            {data['source']}"))
        print()

    return EX_NETWORK if failures else EX_OK


def _iso(epoch_seconds: float | None) -> str:
    if not epoch_seconds:
        return ""
    return datetime.fromtimestamp(epoch_seconds, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


