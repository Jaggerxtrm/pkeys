                    if fetched:
                        state.setdefault("limits", {})[prov.name] = {
                            "fetchedAt": time.time(),
                            "data": fetched,
                        }
                except PkeysError as exc:
                    state.setdefault("limits", {})[prov.name] = {
                        "fetchedAt": time.time(),
                        "data": {"state": "unknown", "note": exc.message},
                    }
        save_state(state)

    rows = []
    names = sorted(providers)
    for name in names:
        prov = providers[name]
        totals = month_totals.get(name, {})
        tokens = totals.get("totalTokens")
        cost = totals.get("cost")
        source = prov.key_source
        if prov.has_conflict:
            source += " " + style.yellow("(conflict)")
        label = name
        if name == cfg.default_provider and not args.plain:
            label = style.bold(name) + style.dim(" *")
        rows.append(
            [
                label,
                auth_state(prov, state, style),
                source,
                str(len(prov.models)) if prov.models else "-",
                sub_state(prov, state, style),
                human_int(tokens),
                human_money(cost),
                limit_state(prov, live.get(name)),
                prov.fingerprint,
            ]
        )

    if args.json:
        payload = {
            "month": month,
            "default": {"provider": cfg.default_provider, "model": cfg.default_model},
            "providers": {
                name: {
                    "auth": _plain(auth_state(providers[name], state, Style(False))),
                    "authType": providers[name].auth_type,
                    "keySource": providers[name].key_source,
                    "fingerprint": providers[name].fingerprint,
                    "baseUrl": providers[name].base_url,
                    "models": len(providers[name].models),
                    "usage": month_totals.get(name, {}),
                    "limits": limit_state(providers[name], live.get(name)),
                    "live": live.get(name),
                }
                for name in names
            },
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return EX_OK

    if args.plain:
        print("provider\tauth\tkey_source\tmodels\ttokens\tcost\tlimits\tfingerprint")
        for row in rows:
            print("\t".join(_plain(c) for c in row))
    else:
        headers = ["PROVIDER", "AUTH", "KEY SOURCE", "MODELS", "SUB", "TOKENS", "COST", "LIMITS", "KEY"]
        print(render_table(headers, rows, style))
        total_tokens = sum((month_totals.get(n, {}).get("totalTokens") or 0) for n in names)
        total_cost = sum((month_totals.get(n, {}).get("cost") or 0) for n in names)
        print()
        print(
            style.dim(
                f"{month}: {human_int(total_tokens)} tokens, {human_money(total_cost)} recorded across "
                f"{len(names)} providers"
            )
        )
        if not args.live:
            print(style.dim("SUB and provider limits are as of the last --live run. Nothing was fetched now."))
        print()
        print(style.dim("Next: pkeys limits    pkeys usage    pkeys models    pkeys doctor    pkeys rotate --provider <name>"))
    return EX_OK


