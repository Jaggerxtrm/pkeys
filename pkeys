def cmd_status(args, style: Style) -> int:
    cfg = load_config()
    providers = build_providers(cfg)
    state = load_state()
    month = args.month or current_month()
    usage = scan_sessions(use_cache=not args.no_cache, quiet=args.quiet) if not args.no_usage else {}
    month_totals = provider_month_totals(usage, month)

    live: dict[str, dict] = {}
    if args.live:
        for prov in sorted(providers.values(), key=lambda p: p.name):
            if not prov.key or prov.auth_type == "oauth":
                continue
            try:
                live[prov.name] = live_usage(prov, month) or {}
                state.setdefault("checks", {})[prov.name] = {
                    "state": "active",
                    "checkedAt": time.time(),
                }
            except PkeysError as exc:
                live[prov.name] = {"error": exc.message}
                state.setdefault("checks", {})[prov.name] = {
                    "state": "invalid",
                    "checkedAt": time.time(),
                    "detail": exc.message,
                }
            if prov.name in LIMIT_ADAPTERS:
                try:
