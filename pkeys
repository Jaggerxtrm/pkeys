def print_help(command: str | None = None) -> int:
    if command and command in COMMAND_HELP:
        print(COMMAND_HELP[command].format(home=home(), rotation_log_path=rotation_log_path()))
        return EX_OK
    if command:
        close = difflib.get_close_matches(command, list(COMMAND_HELP), n=1)
        hint = f"Did you mean 'pkeys help {close[0]}'?" if close else ""
        raise PkeysError(f"no help for '{command}'", EX_USAGE, hint or "pkeys help")
    commands = "\n".join(f"  {name:<8}{summary}" for name, summary in COMMAND_SUMMARY)
    print(LONG_HELP)
    print("Commands:")
    print(commands)
    return EX_OK


